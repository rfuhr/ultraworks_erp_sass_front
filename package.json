{
  "name": "frontend-template",
  "version": "0.1.0",
  "description": "Template de bootstrap para aplicações frontend Angular com design system uw-ui",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve frontend",
    "build": "ng build frontend",
    "watch": "ng build frontend --watch --configuration development",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:coverage": "jest --config jest.config.js --coverage",
    "lint": "eslint \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "typecheck": "tsc -p apps/frontend/tsconfig.app.json --noEmit",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "storybook": "ng run uw-ui:storybook",
    "build-storybook": "ng run uw-ui:build-storybook"
  },
  "dependencies": {
    "@angular/animations": "^21.2.0",
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "ngx-mask": "^21.0.1",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "21.4.0",
    "@angular/build": "^21.2.30",
    "@angular/cli": "^21.2.30",
    "@angular/compiler-cli": "^21.2.0",
    "@angular/platform-browser-dynamic": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-docs": "^9.1.20",
    "@storybook/angular": "^9.1.20",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/jest": "^30.0.0",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-preset-angular": "^16.1.5",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "sass": "^1.108.2",
    "storybook": "^9.1.20",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "zone.js": "^0.16.2"
  }
}
